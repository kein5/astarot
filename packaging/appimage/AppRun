#!/bin/bash
set -eu
APPDIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
export APPDIR
# Keep the host environment before linuxdeploy's GUI hooks modify it.
# A record that is already there stays: the app restarting itself after an in-app update starts
# this image with the GUI's environment, and recording that again would give the programs the app
# starts the old mount's paths as the host's (#1016).
for name in LD_LIBRARY_PATH PATH GIO_EXTRA_MODULES GSETTINGS_SCHEMA_DIR GTK_PATH GTK_EXE_PREFIX GTK_DATA_PREFIX GTK_IM_MODULE_FILE GTK_THEME GDK_PIXBUF_MODULE_FILE GI_TYPELIB_PATH XDG_DATA_DIRS GDK_BACKEND WEBKIT_DISABLE_DMABUF_RENDERER GTK_IM_MODULE XMODIFIERS; do
    recorded=
    eval 'recorded=${ASTAROT_APPIMAGE_HOST_'"$name"'_SET+x}'
    [ "$recorded" = x ] && continue
    eval 'present=${'"$name"'+x}'
    eval 'value=${'"$name"'-}'
    export "ASTAROT_APPIMAGE_HOST_${name}_SET=$present"
    export "ASTAROT_APPIMAGE_HOST_${name}=$value"
done
# Verified NVIDIA GBM allocation failure on this AppImage. Keep other GPUs and
# explicit user choices unchanged; this affects WebKit rendering, not inference.
if [ -d /sys/module/nvidia ] && [ "${WEBKIT_DISABLE_DMABUF_RENDERER+x}" != x ]; then
    export WEBKIT_DISABLE_DMABUF_RENDERER=1
fi
# GTK runs on X11 here and loads only the bundled input method modules, which
# do not include fcitx or ibus. Reach the host input method over XIM instead.
if [ -z "${XMODIFIERS-}" ] && command -v pgrep >/dev/null 2>&1; then
    if pgrep -x fcitx5 >/dev/null 2>&1 || pgrep -x fcitx >/dev/null 2>&1; then
        export XMODIFIERS=@im=fcitx
    elif pgrep -x ibus-daemon >/dev/null 2>&1; then
        export XMODIFIERS=@im=ibus
    fi
fi
case "${GTK_IM_MODULE-}" in
    ''|fcitx|fcitx5|ibus|wayland) [ -z "${XMODIFIERS-}" ] || export GTK_IM_MODULE=xim ;;
esac
# Whether the host's loader finds this library: its cache, or without ldconfig the usual folders.
host_has_library() {
    local ldconfig folder
    for ldconfig in "$(command -v ldconfig || true)" /sbin/ldconfig /usr/sbin/ldconfig; do
        if [ -n "$ldconfig" ] && [ -x "$ldconfig" ]; then
            "$ldconfig" -p 2>/dev/null | grep -qF "$1 (libc6,x86-64)"
            return
        fi
    done
    for folder in /lib/x86_64-linux-gnu /usr/lib/x86_64-linux-gnu /lib64 /usr/lib64 /lib /usr/lib; do
        [ -e "$folder/$1" ] && return 0
    done
    return 1
}
# The GUI's bundled libraries. The ASTAROT_APPIMAGE_HOST_* copies above keep the host values.
export LD_LIBRARY_PATH="$APPDIR/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
# A library left to the host, such as libpipewire, which loads the host's PipeWire modules and
# must match them. Only where the host has none, the image's copy comes last, so that the app
# starts; there is then no PipeWire to play audio through (#1205).
for fallback in "$APPDIR"/usr/lib/fallback/*/; do
    [ -d "$fallback" ] || continue
    fallback=${fallback%/}
    host_has_library "${fallback##*/}" || LD_LIBRARY_PATH="$LD_LIBRARY_PATH:$fallback"
done
export PATH="$APPDIR/usr/bin:$PATH"
# The GTK plugin relocates WebKit's /usr paths to ././. Match AppImageKit's
# working directory and let linuxdeploy's generated wrapper source hooks once.
cd "$APPDIR/usr"
exec "$APPDIR/AppRun.gui" "$@"
