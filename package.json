{
  "name": "astarot",
  "private": true,
  "version": "0.7.0-beta.2",
  "type": "module",
  "scripts": {
    "build-resources": "bat\\build.bat",
    "stage-resources": "python tools/app_resources.py stage --allow-missing",
    "vite": "vite",
    "vite-build": "vite build",
    "vite-preview": "vite preview",
    "tauri": "tauri",
    "tauri-dev": "tauri dev",
    "task-kill": "python utils\\task_kill.py",
    "clean": "python utils\\clean.py",
    "clean-soft": "python utils\\clean.py --soft",
    "update-version": "python utils\\update_version.py",
    "changelog": "python tools/changelog.py write",
    "dev": "npm run task-kill && npm run clean && npm run update-version && npm run build-resources && npm run dev-ui",
    "dev-fast": "npm run task-kill && npm run stage-resources && npm run dev-ui",
    "dev-ui": "npm run task-kill && npm-run-all --parallel vite tauri-dev",
    "analyze-error": "node utils/analyze_ui_error.js",
    "build": "npm run task-kill && npm run clean-soft && npm run update-version && npm run build-resources && npm run vite-build && npm run tauri build",
    "release": "npm run update-version && npm run build && python utils\\zip.py --zip_name ASTAROT.zip",
    "dev:web": "vite",
    "dev:catalog": "storybook dev --port 6006 --no-version-updates",
    "build:catalog": "storybook build --output-dir build/storybook",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json && tsc -p tests/integration/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "mutator"
  },
  "dependencies": {
    "@babel/standalone": "8.1.1",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-visually-hidden": "1.2.13",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-global-shortcut": "2.4.1",
    "@tauri-apps/plugin-opener": "2.7.3",
    "@vanilla-extract/css": "1.21.3",
    "@vanilla-extract/recipes": "0.5.7",
    "clsx": "2.1.1",
    "i18next": "27.2.2",
    "jotai": "3.0.2",
    "js-base64": "3.9.6",
    "jszip": "3.10.2",
    "react": "19.3.1",
    "react-colorful": "5.8.1",
    "react-dom": "19.3.1",
    "react-error-boundary": "6.1.6",
    "react-i18next": "18.0.1",
    "react-resizable-layout": "0.7.3",
    "react-toastify": "11.2.0",
    "semver": "7.8.6",
    "virtua": "0.54.2"
  },
  "devDependencies": {
    "@babel/parser": "8.1.0",
    "@babel/types": "8.1.0",
    "@mizchi/mutator": "0.2.0",
    "@playwright/test": "1.65.0",
    "@rollup/plugin-yaml": "5.0.1",
    "@storybook/react-vite": "10.6.7",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vanilla-extract/vite-plugin": "5.2.6",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "npm-run-all2": "9.0.4",
    "source-map": "0.8.0",
    "storybook": "10.6.7",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vite-plugin-svgr": "5.2.0",
    "vitest": "5.1.0"
  },
  "overrides": {
    "i18next": {
      "typescript": "$typescript"
    },
    "react-i18next": {
      "typescript": "$typescript"
    }
  }
}
