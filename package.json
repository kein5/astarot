{
  "name": "vrct-vox",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "setup-python": "bat\\install.bat",
    "build-resources": "bat\\build.bat",
    "stage-resources": "python tools/app_resources.py stage --allow-missing",
    "vite": "vite",
    "vite-build": "vite build",
    "vite-preview": "vite preview",
    "tauri": "tauri",
    "tauri-dev": "tauri dev",
    "task-kill": "python utils\\task_kill.py",
    "clean": "python utils\\clean.py",
    "clean-soft": "python utils\\clean.py --soft",
    "update-version": "python utils\\update_version.py",
    "changelog": "python tools/changelog.py write",
    "dev": "npm run task-kill && npm run clean && npm run update-version && npm run build-resources && npm run dev-ui",
    "dev-fast": "npm run task-kill && npm run stage-resources && npm run dev-ui",
    "dev-ui": "npm run task-kill && npm-run-all --parallel vite tauri-dev",
    "analyze-error": "node utils/analyze_ui_error.js",
    "build": "npm run task-kill && npm run clean-soft && npm run update-version && npm run build-resources && npm run vite-build && npm run tauri build",
    "release": "npm run update-version && npm run build && python utils\\zip.py --zip_name VRCT-VOX.zip",
    "release-cuda": "npm run update-version && npm run build && python utils\\zip.py --zip_name VRCT-VOX_cuda.zip",
    "release-all": "npm run update-version && npm run release && npm run release-cuda",
    "doctor": "python tools/dev.py doctor",
    "check": "python tools/dev.py check",
    "check:all": "python tools/dev.py check --scope all",
    "check:commits": "python tools/dev.py check --scope commits",
    "test:voice": "python tools/dev.py check --scope voice",
    "test:ui": "python tools/dev.py check --scope ui",
    "setup:headless": "python tools/dev.py setup --scope headless",
    "setup:browser": "python tools/dev.py setup --scope browser",
    "dev:web": "vite",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@babel/standalone": "7.27.0",
    "@radix-ui/react-visually-hidden": "1.2.13",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-global-shortcut": "2.4.1",
    "@tauri-apps/plugin-opener": "2.7.3",
    "@vanilla-extract/css": "1.21.3",
    "clsx": "2.1.1",
    "i18next": "25.0.1",
    "jotai": "2.12.3",
    "js-base64": "3.7.7",
    "jszip": "3.10.1",
    "react": "18.3.1",
    "react-colorful": "5.6.1",
    "react-dom": "18.3.1",
    "react-error-boundary": "5.0.0",
    "react-i18next": "15.5.1",
    "react-resizable-layout": "0.7.2",
    "react-toastify": "11.0.5",
    "sass": "1.79.4",
    "semver": "7.7.1",
    "virtua": "0.53.5"
  },
  "devDependencies": {
    "@rollup/plugin-yaml": "4.1.2",
    "@tauri-apps/cli": "2.12.4",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vanilla-extract/vite-plugin": "5.2.6",
    "@vitejs/plugin-react": "4.4.1",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "npm-run-all2": "9.0.4",
    "source-map": "0.7.4",
    "typescript": "5.9.3",
    "vite": "6.4.5",
    "vite-plugin-svgr": "4.3.0"
  }
}
