{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["src-ui/**/*.{ts,tsx}", "locales/*.ts", "tools/**/*.mjs", "*.js", "*.mjs"]
  },
  "formatter": {
    "enabled": true,
    "useEditorconfig": true,
    "lineWidth": 120,
    "includes": ["*.js", "*.mjs", "tools/**/*.mjs"]
  },
  "linter": {
    "enabled": true,
    "domains": {
      "playwright": "none"
    },
    "rules": {
      "preset": "recommended",
      "a11y": {
        "noAutofocus": "warn",
        "noLabelWithoutControl": "warn",
        "noNoninteractiveTabindex": "warn",
        "noStaticElementInteractions": "warn",
        "noSvgWithoutTitle": "warn",
        "useAltText": "warn",
        "useAriaPropsSupportedByRole": "warn",
        "useButtonType": "warn",
        "useFocusableInteractive": "warn",
        "useKeyWithClickEvents": "warn",
        "useKeyWithMouseEvents": "warn",
        "useSemanticElements": "warn"
      },
      "complexity": {
        "useMathMinMax": "error",
        "useOptionalChain": "error"
      },
      "correctness": {
        "noComponentHookFactories": "warn",
        "noUnreachable": "warn",
        "noUnusedFunctionParameters": "error",
        "useExhaustiveDependencies": "warn",
        "useHookAtTopLevel": "warn"
      },
      "style": {
        "useConst": "error"
      },
      "suspicious": {
        "noArrayIndexKey": "warn",
        "noAssignInExpressions": "warn",
        "noControlCharactersInRegex": "warn",
        "noGlobalIsNan": "error",
        "noImplicitAnyLet": "warn",
        "useIterableCallbackReturn": "warn"
      }
    }
  },
  "assist": {
    "enabled": false
  }
}
