{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "ASTAROT",
    "version": "0.7.0-beta.3",
    "identifier": "io.github.kein5.astarot",
    "build": {
        "beforeDevCommand": "",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "",
        "frontendDist": "../dist"
    },
    "app": {
        "enableGTKAppId": false,
        "windows": [
            {
                "create": false,
                "title": "ASTAROT",
                "center": true,
                "visible": false,
                "width": 870,
                "height": 654,
                "minWidth": 400,
                "minHeight": 200,
                "transparent": true,
                "decorations": false,
                "shadow": false,
                "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,CalculateNativeWinOcclusion --disable-backgrounding-occluded-windows --disable-renderer-backgrounding --disable-background-networking"
            }
        ],
        "security": {
            "csp": {
                "default-src": "'self'",
                "script-src": "'self'",
                "style-src": [
                    "'self'",
                    "'sha256-I2px+fnpbN4E5+Djrj7aoTIyq9yyREkuVl19f4Sye9A='",
                    "'sha256-wBAOjWqzlHdwhuIyV//yRl4v0VNTHc3TOqbIfNXoA7k='"
                ],
                "style-src-attr": "'none'",
                "img-src": "'self' data:",
                "font-src": "'self'",
                "connect-src": "'self' ipc: http://ipc.localhost https://ipc.localhost",
                "media-src": "'none'",
                "worker-src": "'none'",
                "frame-src": "'none'",
                "object-src": "'none'",
                "base-uri": "'self'",
                "frame-ancestors": "'none'",
                "form-action": "'none'"
            },
            "capabilities": [
                "default",
                "quick-chat",
                "caption-overlay",
                "companion",
                "vr-panel",
                "settings-window",
                "vrct-capability"
            ],
            "devCsp": {
                "default-src": "'self'",
                "script-src": "'self' 'unsafe-inline'",
                "style-src": "'self' 'unsafe-inline'",
                "style-src-attr": "'none'",
                "img-src": "'self' data:",
                "font-src": "'self'",
                "connect-src": "'self' ipc: http://ipc.localhost https://ipc.localhost ws://localhost:1420 ws://127.0.0.1:1420 ws://localhost:1421 ws://127.0.0.1:1421",
                "media-src": "'none'",
                "worker-src": "'none'",
                "frame-src": "'none'",
                "object-src": "'none'",
                "base-uri": "'self'",
                "frame-ancestors": "'none'",
                "form-action": "'none'"
            }
        }
    },
    "bundle": {
        "active": true,
        "targets": "nsis",
        "publisher": "kein5",
        "copyright": "Copyright m's software",
        "licenseFile": "../LICENSE",
        "shortDescription": "ASTAROT — speech, voice conversion and translated chat",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "resources": {
            "bin/_internal": "_internal"
        },
        "windows": {
            "nsis": {
                "template": "nsis/template.nsi",
                "installMode": "currentUser",
                "displayLanguageSelector": true,
                "languages": [
                    "English",
                    "Japanese"
                ]
            }
        }
    },
    "mainBinaryName": "astarot",
    "plugins": {
        "updater": {
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDExNzg4MzZFNUM5RjUxMEIKUldRTFVaOWNib040RVdueGp0Zyt4WWFEYXoyOUoweDBUL1hRY2YyczNVekoxdnBsc3F1d0o2SVUK",
            "endpoints": [
                "https://vrct-vox-updates.kei9d09.workers.dev/latest.json"
            ],
            "requireSignedVersion": true,
            "windows": {
                "installMode": "passive"
            }
        }
    }
}
